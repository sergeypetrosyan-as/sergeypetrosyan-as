{
  "name": "paradox-room",
  "private": true,
  "version": "1.0.0",
  "description": "PARADOX ROOM — an impossible-space puzzle adventure. Fold small rooms a quarter-turn at a time so walls become floors.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:levels": "node --experimental-strip-types scripts/check-levels.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "three": "0.170.0"
  }
}
