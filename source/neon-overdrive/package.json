{
  "name": "neon-overdrive",
  "private": true,
  "version": "1.0.0",
  "description": "NEON OVERDRIVE — futuristic pseudo-3D arcade racing. Burn the reserve. Cut the Spine.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
