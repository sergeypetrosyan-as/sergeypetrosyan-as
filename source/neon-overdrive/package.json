  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "dependencies": {
    "@fontsource/barlow": "5.1.0",
    "@fontsource/barlow-condensed": "5.1.0",
    "three": "0.170.0"
  }
}
